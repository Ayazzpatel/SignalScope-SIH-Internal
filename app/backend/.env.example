# Copy to .env and adjust. All values are optional in development — defaults shown.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Database. Default (unset) is a local SQLite file in app/backend/data/.
# For Postgres, e.g. the dev container from the README:
# DATABASE_URL=postgresql+asyncpg://signalscope:signalscope@localhost:55432/signalscope
AUTO_MIGRATE=true
SEED_DEMO_USERS=true

# Auth. SECRET_KEY is required in production (>= 32 chars). Unset in development = random per restart.
# SECRET_KEY=
ACCESS_TOKEN_TTL_S=900
COOKIE_SECURE=false

# Detector: "mock" (built-in fake results) or "ml" (calls model/predict.py)
DETECTOR=ml
MOCK_LATENCY_MS=0
ML_MODULE=model.predict
ML_DEVICE=cpu
# E1 weights are found automatically in model/model/signalscope_E1/; set this only to use a different file.
# SIGNALSCOPE_MODEL_PATH=

# Verdict bands on calibrated prob_ai (ML team supplies the final values)
BAND_LIKELY_REAL_MAX=0.35
BAND_LIKELY_AI_MIN=0.65

# Secondary models (loaded only when DETECTOR=ml). Weights are found automatically in model/model/<name>/
# or app/backend/signalscope/ML/model/<name>/; set these only to use a different file.
# SIGNALSCOPE_STANDALONE_MODEL_PATH=
# SIGNALSCOPE_E2_MODEL_PATH=

# Combined verdict shown in the UI: "Likely AI-generated" if ANY model's P(AI) reaches this value
ENSEMBLE_AI_THRESHOLD=0.25
