# Copy to .env and adjust. All values are optional — defaults shown.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Detector: "mock" (built-in fake results) or "ml" (calls model/predict.py)
DETECTOR=mock
MOCK_LATENCY_MS=0
ML_MODULE=model.predict
ML_DEVICE=cpu

# Verdict bands on calibrated prob_ai (ML team supplies the final values)
BAND_LIKELY_REAL_MAX=0.35
BAND_LIKELY_AI_MIN=0.65
